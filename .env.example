POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_PORT=8000

# С хоста Alembic подключается к опубликованному порту Postgres.
# В контейнере приложения compose подставляет хост db сам.
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator

# Прод-compose. Dev-compose эти переменные не читает.
# Домен без схемы, например example.com.
SITE_ADDRESS=example.com
ACME_EMAIL=you@example.com
